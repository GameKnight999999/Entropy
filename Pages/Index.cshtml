@page "/"
@using Entropy.Pages

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Измерение информации — Entropy App</title>

    @* Шрифты *@
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">

    <style>
        body { 
            background: #0a1930; 
            color: #d0eaff; 
            font-family: 'Segoe UI', Arial, sans-serif; 
            min-height: 100vh;
        }
        
        .container { 
            max-width: 1200px; 
            margin: 0 auto; 
            padding: 1.5rem; 
        }
        
        .tron-card { 
            background: rgba(79,195,247,0.08); 
            border: 2px solid #4fc3f7; 
            border-radius: 16px; 
            padding: 2rem; 
            margin-bottom: 1.5rem; 
            backdrop-filter: blur(10px);
        }
        
        h1, h2 { 
            color: #4fc3f7; 
            text-shadow: 0 0 10px rgba(79,195,247,0.5); 
            font-family: 'Orbitron', sans-serif; 
            letter-spacing: 1px;
        }
        
        body h1 { font-size: 2.8rem; margin-bottom: 0.5rem; text-align: center;}
        body h2 { font-size: 1.8rem; margin-top: 0;}
        sub { font-size: 70%;}
        
        .code { 
            background: linear-gradient(135deg, rgba(79,195,247,0.15), rgba(10,36,99,0.8)); 
            border-radius: 6px; 
            padding: 1rem; 
            font-family: 'Consolas', monospace; 
            font-size: 1.1em; 
            border-left: 4px solid #4fc3f7;
        }
        
        .form-group { margin-bottom: 1.5rem;}
        
        .control-group {
            background: rgba(10,27,100,0.6);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid rgba(79,195,247,0.3);
        }

        label.tron-label { 
            display: block; 
            color: #82b1ff; 
            margin-bottom: 0.5rem; 
            font-family: 'Orbitron'; 
            font-size: 0.9rem; 
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        select, input[type="number"], textarea {
            width: 100%;
            background: rgba(26,54,127,0.8);
            border: 2px solid #4fc3f7;
            border-radius: 8px;
            padding: 0.8rem;
            color: #d0eaff;
            font-family: 'Segoe UI', Arial;
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        
        select:focus, input[type="number"]:focus {
            outline: none;
            box-shadow: 0 0 15px rgba(79,195,247,0.6);
            background: rgba(10,38,122,0.9);
        }
        
        select option {
            background: #0a1930;
        }
        
        .error-message {
            color: #ff4f4f;
            padding: 0.5rem 1rem;
            background: rgba(255,79,79,0.1);
            border-radius: 8px;
            border-left: 3px solid #ff4f4f;
            margin-top: 0.5rem;
        }
        
        .success-message {
            color: #4caf50;
            padding: 0.5rem 1rem;
            background: rgba(76,175,80,0.1);
            border-radius: 8px;
            border-left: 3px solid #4caf50;
            margin-top: 0.5rem;
        }
        
        .result-box {
            background: linear-gradient(135deg, rgba(79,195,247,0.15), rgba(10,36,99,0.8));
            border-radius: 12px;
            padding: 1.5rem;
            font-family: 'Consolas', monospace;
        }
        
        .result-highlight {
            color: #4fc3f7;
            text-shadow: 0 0 8px rgba(79,195,247,0.5);
        }

        h3 { font-size: 1.5rem; margin-bottom: 0.8rem;}
    </style>
</head>
<body>
    <div class="container">
        
        <!-- Шапка -->
        <header style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; background: linear-gradient(90deg, rgba(10,36,99,0.95), rgba(26,35,126,0.9)); border-bottom: 2px solid #4fc3f7;">
            <div style="color: #4fc3f7; font-family: 'Orbitron'; font-weight: 900; font-size: 1.8rem;">ENTROPY</div>
        </header>

        <main>
            
            <!-- Часть 0: Теория (всегда видна) -->
            <div class="tron-card" style="margin-bottom: 2rem;">
                <h1 style="text-align: left; margin-left: 0;">🍀 Измерение информации в сообщении</h1>
                
                <div style="background: linear-gradient(135deg, rgba(79,195,247,0.08), rgba(26,35,126,0.6)); border-radius: 12px; padding: 1.5rem;">
                    <h3 style="color: #4fc3f7; margin-bottom: 0.5rem;">📐 Формула</h3>
                    <div class="code" style="font-size: 2rem; text-align: center; border-left-width: 6px;">V = N · log<sub>2</sub>(I)</div>
                    <div style="margin-top: 1.5rem; color: rgba(255,255,255,0.8);">
                        <p><strong>V</strong> — объём сообщения (биты) <span class="result-highlight"></span></p>
                        <p><strong>N</strong> — длина сообщения (количество символов) <span class="result-highlight"></span></p>
                        <p><strong>I</strong> — мощность алфавита (сколько разных символов) <span class="result-highlight"></span></p>
                    </div>
                </div>
            </div>

            <!-- Часть 1: Интерактивный калькулятор -->
            <div class="tron-card">
                
                <!-- Выбор алфавита -->
                <div style="text-align: center; margin-bottom: 1.5rem;">
                    <label for="alphabetSelect" class="tron-label">Выберите алфавит:</label>
                    <select id="alphabetSelect" name="alphabet" 
                            value="@IndexModel.SelectedAlphabet">
                        <option value="russian">Русский (~33 символа)</option>
                        <option value="english">Английский (26 букв)</option>
                        <option value="ascii">ASCII без управления (95 символов)</option>
                    </select>
                </div>

                <div style="background: rgba(26,54,127,0.8); padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                    <p style="margin: 0; font-size: 1.1rem;"><strong>Выбран:</strong> @IndexModel.AlphabetName</p>
                    <p style="font-size: 1rem; color: #a0b5d5;">Мощность алфавита <strong>I = @IndexModel.AlphabetSize</strong> символа(-ов)</p>
                    
                    <div style="background: rgba(79,195,247,0.15); border-radius: 6px; padding: 1rem; margin-top: 1rem;">
                        <p style="margin: 0;"><strong>Теоретический минимум:</strong></p>
                        <div class="code">log<sub>2</sub>(@IndexModel.AlphabetSize) = @(Math.Round(IndexModel.MinimumKBits)) бит на символ</div>
                    </div>
                </div>

                <!-- Выбор k_bits -->
                <div class="control-group">
                    <label class="tron-label" style="margin-bottom: 0;">Шаг — Биты на символ:</label>
                    
                    <div class="form-group">
                        <input 
                            type="number" 
                            name="UserKBits" 
                            value="@IndexModel.UserKBits"
                            min="0" 
                            max="8"
                        />
                        <p style="font-size: 0.9rem; color: #a0b5d5; margin-top: 0.3rem;">
                            Рекомендуемый @(Math.Round(IndexModel.MinimumKBits, 1)) бит для полного кодирования алфавита
                        </p>
                        
                        <!-- Валидация -->
                        if (@IndexModel.MessageLength > 0 && @IndexModel.IsInsufficientBits)
                        {
                            <div class="error-message">
                                ❌ Ошибка: выбранные @IndexModel.UserKBits бит(a) меньше минимального@(Math.Round(IndexModel.MinimumKBits, 1)) бита(ов)!
                            </div>
                        }
                    </div>

                    <!-- Шаг: Длина сообщения -->
                    <div class="form-group">
                        <label for="N_input" class="tron-label">Длина сообщения N (символы):</label>
                        
                        <input 
                            type="number" 
                            id="N_input" 
                            name="MessageLength" 
                            value="@IndexModel.MessageLength"
                            min="5" 
                            max="@IndexModel.MAX_N"
                        />
                        
                        if (@IndexModel.OutOfNRange)
                        {
                            <div class="error-message">
                                ⚠️ N должно быть в пределах 5–@IndexModel.MAX_N символов
                            </div>
                        }
                        
                        <p style="font-size: 0.9rem; color: #a0b5d5; margin-top: 0.3rem;">
                            N = @IndexModel.MessageLength символ(ов)
                        </p>
                    </div>

                    <!-- Шаг 4/Финал: Результат -->
                    <div style="background: linear-gradient(135deg, rgba(79,195,247,0.1), rgba(26,35,126,0.8)); border-radius: 12px; padding: 1.5rem; margin-top: 1.5rem;">
                        
                        <h3 style="color: #4fc3f7; margin-bottom: 0.8rem; text-align: center;">🍀 Результат</h3>
                        
                        @* Расчёт --> *@
                        <div class="result-box">
                            <div style="margin-bottom: 1rem;">
                                <p style="color: #a0b5d5; margin: 0;">Формула:</p>
                                <div class="code" style="text-align: center; border-left-width: 6px;">V = N × k_bits</div>
                            </div>

                            <div style="background: rgba(10,27,100,0.6); border-radius: 8px; padding: 1rem; min-height: 5rem;">
                                <p style="margin: 0.5rem 0;"><strong>N</strong> = @IndexModel.MessageLength символ(ов)</p>
                                <p style="margin: 0.5rem 0;"><strong>k</strong>bits = <span class="result-highlight">@IndexModel.UserKBits</span> бит на символ</p>
                                
                                @{
                                    if (@IndexModel.MessageLength > 0) {
                                        <div style="background: rgba(79,195,247,0.1); border-radius: 6px; padding: 0.8rem; margin-top: 0.5rem; text-align: center;">
                                            <strong>V = @IndexModel.MessageLength × @IndexModel.UserKBits = @IndexModel.TotalBits</strong> бит
                                        </div>

                                        @* Округление --> *@
                                        if (@IndexModel.IsExactBitCount) { } else { 
                                            <div style="background: rgba(138,43,226,0.1); border-radius: 6px; padding: 0.8rem; margin-top: 0.5rem;">
                                                <p style="margin: 0;"><strong>Превращаем биты в байты:</strong></p>
                                                 @* Округление вверх --> *@
                                               if (@IndexModel.TotalBits % 8 == 0) {
                                                   <div class="code" style="background: rgba(79,195,247,0.1); padding: 0.5rem; margin-top: 0.5rem;">@(@IndexModel.TotalBits / 8) байт</div>
                                               } else {
                                                   var inBytes = (int)Math.Ceiling(@IndexModel.TotalBits / 8.0);
                                                   <div class="code">@IndexModel.TotalBits бит → @((int)Math.Ceiling(IndexModel.TotalBits / 8.0)) байт</div>
                                                   <p style="font-size: 0.8rem; color: #a0b5d5; margin-top: 0.3rem;">(округление вверх до полного байта)</p>
                                               }
                                                
                                                 <div class="code" style="background: rgba(79,195,247,0.1); padding: 0.5rem; margin-top: 0.5rem;">Итоговый объём: @IndexModel.ByteCount байт</div>
                                             </div>
                                         }

                                         <!-- Визуализация бит -->
                                         if (@IndexModel.UserKBits > 0 && @IndexModel.MessageLength > 0) {
                                             int bitCount = Math.Min(@IndexModel.TotalBits, 50);
                                               @for (var i = 0; i < bitCount / 10; i++){
                                                   <div style="display: inline-block; width: 10px; height: 10px; background: #4fc3f7; margin: 2px; border-radius: 2px;"></div>
                                             }
                                         }

                                     } else {
                                         <p style="color: #a0b5d5; text-align: center;">Введите длину сообщения (N ≥ 5), чтобы увидеть результат.</p>
                                     }
                                 }
                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </main>


    </div>
</body>
</html>
