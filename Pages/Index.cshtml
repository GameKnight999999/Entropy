@page "/"
@using Entropy.Pages
@model Entropy.Pages.IndexModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Измерение информации — Entropy App</title>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0a1930;
            --accent: #4fc3f7;
            --text: #d0eaff;
            --muted: #a0b5d5;
            --error: #ff5c5c;
            --ok: #4caf50;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: radial-gradient(circle at top, #102a52 0%, #0a1930 45%, #061020 100%);
            color: var(--text);
            font-family: 'Segoe UI', Arial, sans-serif;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem;
        }

        header.top {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 1rem;
            padding: 1rem 0;
            border-bottom: 2px solid var(--accent);
            margin-bottom: 1.5rem;
        }

        .logo {
            color: var(--accent);
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 1.8rem;
            letter-spacing: 3px;
            text-shadow: 0 0 12px rgba(79, 195, 247, 0.6);
        }

        .subtitle { color: var(--muted); font-size: 0.95rem; }

        .tron-card {
            background: rgba(79, 195, 247, 0.08);
            border: 2px solid var(--accent);
            border-radius: 16px;
            padding: 1.75rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 0 24px rgba(79, 195, 247, 0.12);
            backdrop-filter: blur(10px);
        }

        h1, h2, h3 {
            color: var(--accent);
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 1px;
        }

        h1 { font-size: 1.7rem; margin-top: 0; text-align: center; }
        h2 { font-size: 1.15rem; margin: 1.75rem 0 0.75rem; }
        h3 { font-size: 1rem; margin: 1.5rem 0 0.6rem; }

        .formula {
            text-align: center;
            font-size: 2.4rem;
            color: #ffffff;
            padding: 1rem;
            margin: 0.5rem 0 1rem;
            background: linear-gradient(135deg, rgba(79, 195, 247, 0.12), rgba(26, 35, 126, 0.6));
            border-radius: 12px;
            font-family: 'Consolas', monospace;
        }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 2rem;
            color: var(--muted);
        }

        .legend p { margin: 0.2rem 0; }
        .legend strong { color: var(--accent); }

        .grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1.25rem;
        }

        .grid > .col {
            flex: 1 1 320px;
            min-width: 280px;
        }

        .info-box {
            background: rgba(26, 54, 127, 0.55);
            border: 1px solid rgba(79, 195, 247, 0.3);
            border-radius: 10px;
            padding: 1rem 1.25rem;
        }

        .info-box p { margin: 0.35rem 0; }
        .info-box strong { color: var(--accent); }

        label.tron-label {
            display: block;
            color: #82b1ff;
            margin-bottom: 0.5rem;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        select,
        input[type="number"] {
            width: 100%;
            background: rgba(26, 54, 127, 0.8);
            border: 2px solid var(--accent);
            border-radius: 8px;
            padding: 0.75rem;
            color: var(--text);
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 1rem;
            transition: box-shadow 0.2s ease, background 0.2s ease;
        }

        select:focus,
        input[type="number"]:focus {
            outline: none;
            box-shadow: 0 0 15px rgba(79, 195, 247, 0.6);
            background: rgba(10, 38, 122, 0.9);
        }

        select option { background: var(--bg); }

        .error-message {
            color: var(--error);
            padding: 0.6rem 1rem;
            background: rgba(255, 92, 92, 0.1);
            border-radius: 8px;
            border-left: 3px solid var(--error);
            margin-top: 0.75rem;
            line-height: 1.45;
        }

        .success-message {
            color: var(--ok);
            padding: 0.6rem 1rem;
            background: rgba(76, 175, 80, 0.1);
            border-radius: 8px;
            border-left: 3px solid var(--ok);
            margin-top: 0.75rem;
            line-height: 1.45;
        }

        .code {
            background: linear-gradient(135deg, rgba(79, 195, 247, 0.15), rgba(10, 36, 99, 0.8));
            border-left: 4px solid var(--accent);
            border-radius: 6px;
            padding: 0.9rem 1rem;
            margin: 0.6rem 0;
            font-family: 'Consolas', monospace;
            font-size: 1.05rem;
            overflow-x: auto;
        }

        .code strong { color: #ffffff; }

        .hint {
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.45;
        }

        .result-box {
            background: rgba(10, 27, 100, 0.55);
            border: 1px solid rgba(79, 195, 247, 0.35);
            border-radius: 12px;
            padding: 1.25rem;
            margin-top: 0.5rem;
        }

        .bits {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 0.75rem;
        }

        .bit-group {
            display: flex;
            align-items: center;
            gap: 3px;
            padding: 4px 6px;
            border: 1px solid rgba(79, 195, 247, 0.35);
            border-radius: 6px;
            background: rgba(10, 38, 122, 0.5);
        }

        .bit-group .idx {
            font-size: 0.65rem;
            color: var(--muted);
            margin-right: 3px;
            min-width: 1.2em;
            text-align: right;
        }

        .bit {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 2px;
        }

        .bit.on {
            background: var(--accent);
            box-shadow: 0 0 6px rgba(79, 195, 247, 0.8);
        }

        .bit.off { background: #24406b; }

        .actions { margin-top: 1.5rem; text-align: center; }

        button.calc {
            background: linear-gradient(135deg, #1e88e5, var(--accent));
            color: #04121f;
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 8px;
            font-weight: 700;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.95rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
        }

        button.calc:hover { filter: brightness(1.12); }

        footer {
            text-align: center;
            color: var(--muted);
            font-size: 0.85rem;
            padding: 1rem 0 2rem;
        }

        sub { font-size: 70%; }
    </style>
</head>
<body>
    <div class="container">
        <header class="top">
            <div class="logo">ENTROPY</div>
            <div class="subtitle">Теория информации · интерактивный калькулятор</div>
        </header>

        <main>
            <!-- Теория -->
            <section class="tron-card">
                <h1>🍀 Измерение информации в сообщении</h1>

                <div class="formula">V = N · log<sub>2</sub>(I)</div>

                <div class="legend">
                    <p><strong>V</strong> — объём сообщения (биты)</p>
                    <p><strong>N</strong> — длина сообщения (символы)</p>
                    <p><strong>I</strong> — мощность алфавита (сколько разных символов)</p>
                </div>

                <p class="hint">
                    Для полного кодирования алфавита нужно k = log₂(I) бит на символ.
                    На практике берут целое число бит k_bits, и оно не должно быть меньше log₂(I).
                </p>
            </section>

            <!-- Интерактивный калькулятор -->
            <form method="post" class="tron-card">
                @Html.AntiForgeryToken()

                <h2>Шаг 1. Выбор алфавита</h2>
                <div class="grid">
                    <div class="col">
                        <label class="tron-label" for="alphabetSelect">Готовый алфавит</label>
                        <select id="alphabetSelect" name="SelectedAlphabet" onchange="submitWithScroll(this.form)">
                            @foreach (var alphabet in IndexModel.Alphabets)
                            {
                                if (Model.SelectedAlphabet == alphabet.Key)
                                {
                                    <option value="@alphabet.Key" selected>@alphabet.Name (I = @alphabet.Size)</option>
                                }
                                else
                                {
                                    <option value="@alphabet.Key">@alphabet.Name (I = @alphabet.Size)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col info-box">
                        <p><strong>Выбран:</strong> @Model.AlphabetName</p>
                        <p>Мощность алфавита: <strong>I = @Model.AlphabetSize</strong> @Model.CharsWord(Model.AlphabetSize)</p>
                        <p>log₂(@Model.AlphabetSize) ≈ <strong>@Model.ExactBitsPerCharText</strong> бит/символ</p>
                        <p>Минимальное целое: <strong>k_min = @Model.RequiredKBits</strong> @Model.BitsWord(Model.RequiredKBits)</p>
                    </div>
                </div>

                <h2>Шаг 2. Бит на символ (k_bits)</h2>
                <div class="grid">
                    <div class="col">
                        <label class="tron-label" for="kBitsInput">Сколько бит отводим на один символ?</label>
                        <input id="kBitsInput"
                               type="number"
                               name="UserKBits"
                               value="@Model.UserKBits"
                               min="1"
                               max="8"
                               step="1"
                               onchange="submitWithScroll(this.form)" />
                    </div>

                    <div class="col info-box">
                        <p>Выбрано: <strong>k_bits = @Model.UserKBits</strong> @Model.BitsWord(Model.UserKBits)</p>
                        <p>Требуется не менее <strong>@Model.ExactBitsPerCharText</strong> бит (log₂(I))</p>

                        @if (!Model.IsKBitsInRange)
                        {
                            <div class="error-message">
                                ❌ k_bits должно быть целым числом от @IndexModel.MinKBits до @IndexModel.MaxKBits.
                            </div>
                        }
                        else if (Model.IsKBitsInsufficient)
                        {
                            <div class="error-message">
                                ❌ Недостаточно бит для полного кодирования выбранного алфавита!
                                Увеличьте k_bits хотя бы до @Model.RequiredKBits или выберите алфавит поменьше.
                            </div>
                        }
                        else
                        {
                            <div class="success-message">
                                ✅ Битов достаточно: @Model.UserKBits ≥ @Model.ExactBitsPerCharText
                            </div>
                        }
                    </div>
                </div>

                <h2>Шаг 3. Длина сообщения</h2>
                <div class="grid">
                    <div class="col">
                        <label class="tron-label" for="nInput">Количество символов N (от @IndexModel.MinN до @IndexModel.MaxN)</label>
                        <input id="nInput"
                               type="number"
                               name="MessageLength"
                               value="@Model.MessageLength"
                               min="5"
                               max="256"
                               step="1"
                               onchange="submitWithScroll(this.form)" />
                    </div>

                    <div class="col info-box">
                        <p>N = <strong>@Model.MessageLength</strong> @Model.CharsWord(Model.MessageLength)</p>

                        @if (!Model.IsNValid)
                        {
                            <div class="error-message">
                                ❌ Допустимый диапазон: от @IndexModel.MinN до @IndexModel.MaxN символов.
                            </div>
                        }
                        else
                        {
                            <p class="hint">Диапазон корректный: @IndexModel.MinN ≤ N ≤ @IndexModel.MaxN.</p>
                        }
                    </div>
                </div>

                <h2>Шаг 4. Результат</h2>

                @if (Model.HasResult)
                {
                    <div class="result-box">
                        <p class="hint">Подставляем значения в формулу:</p>

                        <div class="code">
                            V = N × k_bits = @Model.MessageLength × @Model.UserKBits =
                            <strong>@Model.TotalBits</strong> @Model.BitsWord(Model.TotalBits)
                        </div>

                        <div class="code">
                            V<sub>байт</sub> = ⌈V / 8⌉ = ⌈@Model.TotalBits / 8⌉ =
                            <strong>@Model.TotalBytes</strong> @Model.BytesWord(Model.TotalBytes)
                        </div>

                        <p class="hint">
                            @if (Model.IsExactBytes)
                            {
                                <text>@Model.TotalBits делится на 8 нацело — округлять не нужно.</text>
                            }
                            else
                            {
                                <text>@Model.TotalBits не делится на 8 нацело — округляем вверх до полного байта.</text>
                            }
                        </p>

                        <h3>Визуализация: @Model.MessageLength @Model.CharsWord(Model.MessageLength) по @Model.UserKBits @Model.BitsWord(Model.UserKBits)</h3>

                        <div class="bits">
                            @for (var group = 0; group < Model.GroupsToShow; group++)
                            {
                                <div class="bit-group">
                                    <span class="idx">@(group + 1)</span>
                                    @for (var bit = 0; bit < Model.UserKBits; bit++)
                                    {
                                        <span class="bit @(((group + bit) % 2 == 0) ? "on" : "off")"></span>
                                    }
                                </div>
                            }
                        </div>

                        @if (Model.MessageLength > Model.GroupsToShow)
                        {
                            <p class="hint">Показаны первые @Model.GroupsToShow из @Model.MessageLength групп.</p>
                        }

                        <h3>Проверьте себя</h3>
                        <label class="tron-label" for="volumeAnswer">Сколько байт занимает сообщение?</label>
                        <input id="volumeAnswer"
                               type="number"
                               name="UserVolumeBytes"
                               value="@Model.UserVolumeBytes"
                               min="0"
                               step="1"
                               onchange="submitWithScroll(this.form)" />

                        @if (Model.HasVolumeAnswer)
                        {
                            @if (Model.IsVolumeAnswerCorrect)
                            {
                                <div class="success-message">
                                    ✅ Верно! @Model.MessageLength @Model.CharsWord(Model.MessageLength) по @Model.UserKBits @Model.BitsWord(Model.UserKBits)
                                    — это ровно @Model.TotalBytes @Model.BytesWord(Model.TotalBytes).
                                </div>
                            }
                            else
                            {
                                <div class="error-message">
                                    ❌ Пока неверно. Подсказка: V = @Model.TotalBits @Model.BitsWord(Model.TotalBits), а в одном байте 8 бит.
                                    Правильный ответ: @Model.TotalBytes @Model.BytesWord(Model.TotalBytes).
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="hint">Исправьте ошибки в шагах 1–3 — и здесь появится расчёт.</p>
                }

                <div class="actions">
                    <button class="calc" type="submit">Пересчитать</button>
                </div>
            </form>
        </main>

        <footer>Entropy App · V = N · log₂(I) · учебный проект</footer>
    </div>

    <script>
        // Сохраняем позицию прокрутки, чтобы страница не прыгала вверх после пересчёта.
        function submitWithScroll(form) {
            try {
                sessionStorage.setItem('entropy-scroll', String(window.scrollY));
            } catch (e) { /* sessionStorage может быть недоступен */ }
            form.submit();
        }

        document.addEventListener('DOMContentLoaded', function () {
            try {
                var saved = sessionStorage.getItem('entropy-scroll');
                if (saved !== null) {
                    window.scrollTo(0, parseInt(saved, 10) || 0);
                }
            } catch (e) { /* игнорируем */ }

            // Обычная отправка кнопкой тоже сохраняет позицию.
            document.querySelectorAll('form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    try {
                        sessionStorage.setItem('entropy-scroll', String(window.scrollY));
                    } catch (e) { /* игнорируем */ }
                });
            });
        });
    </script>
</body>
</html>
