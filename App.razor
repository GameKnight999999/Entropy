@page "/example"
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <style>body { font-family:'Segoe UI'; background:linear-gradient(180deg, #e8f5ec 0%, #fff 100%); }</style>
</head>
<body style="min-height:100vh;">

<header style="background:#e8f5ec;padding:.5rem;text-align:center;">
    <h1 style="margin:.2rem 0;color:#1a237e;">Измерение информации в сообщении</h1>
    <p style="color:#4fc3f7;font-size:.8rem;margin:0;">Formula V = N · log₂(I)</p>
</header>

<div style="max-width:950px;margin:.5rem auto;padding:0 .2rem;">

<!-- Шаг 1: Формула -->
<section style="background:white;padding:1.5rem;border-radius:12px;margin-top:.5rem;box-shadow:0 2px 8px rgba(79,195,247,0.2);">
    <h2 style="margin:.2rem 0;color:#1976d2;">Шаг 1. Основная формула</h2>
    @* Формула для расчёта объёма *@
    <div style="background:#e8f5ec;padding:1rem;margin:.5rem 0;border-radius:8px;">
        <strong>V = N · log₂(I)</strong><br/>
        — Объём V в битах, N — длина сообщения в символах, I — мощность алфавита.
    </div>
    
    <!-- Пример расчёта по шагам -->
    @if (step <= steps)
    {
        <p style="margin:.5rem 0;">Текущий шаг: @(step + 1). Перехожу к формуле.</p>
    }
</section>

<!-- Шаги навигации -->
<div style="text-align:center;margin-top:.5rem;">
    <button onclick="" location.href='/welcome'" style="background:#4fc3f7;border:none;padding:.8rem 1.5rem;">← На главную</button>
</div>

</div>
</body>
</html>

@code {
    /// <summary>Нивигация между шагами примера (до действия и после него)</summary>
    int step => 0;
    const int steps = 3; // Максимум для демо-навигации
}