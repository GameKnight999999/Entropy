@page "/learn"
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Теория информации | Entropy App</title>
    <link href="_content/Microsoft.AspNetCore.Components.Web/Components/css/bootstrap.min.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <style>
        .learn-container { padding: 2rem; max-width: 1100px; margin: 0 auto; }
        .chapter-card { background: linear-gradient(135deg, rgba(79,195,247,0.1), rgba(26,35,126,0.8)); border-radius: 16px; padding: 2rem; margin-bottom: 2rem; }
        .chapter-title { font-family: 'Orbitron'; color: var(--tron-neon-blue); margin-bottom: 1rem; }
    </style>
</head>
<body>
    <div class="learn-container">
        <header class="tron-header">
            <a href="/welcome" style="text-decoration: none; font-family: 'Orbitron'; color: white;">← Назад</a>
        </header>

        <main>
            <article class="chapter-card">
                <h2 class="chapter-title">🍀 Глава 1. Что такое информация?</h2>
                <details open>
                    <summary style="cursor: pointer;">Что такое энтропия?</summary>
                    <div class="code-block">
                        Информация — это устранение неопределённости.<br/>
                        Энтропия H = log₂(I) бит/символ
                    </div>
                </details>
            </article>

            <article class="chapter-card">
                <h2 class="chapter-title">🔢 Глава 2. Формула V = N · log₂(I)</h2>
                <details open>
                    <summary style="cursor: pointer;">Основная формула</summary>
                    <div style="padding: 1rem; background: rgba(79,195,247,0.1); border-radius: 8px;">
                        V = N · log₂(I)<br/>
                        V — объём (бит), N — длина сообщения (символы), I — мощность алфавита
                    </div>
                </details>
            </article>

            <article class="chapter-card">
                <h2 class="chapter-title">💡 Глава 3. Пример</h2>
                Н = 4 символа, I = 3 состояния<br/>
                V = 4 × log₂(3) ≈ @(string.Format("{0:F2}", 4 * Math.Log(3,2))) бит
            </article>
        </main>

        <footer class="tron-footer">
            <a href="/welcome" style="color: var(--tron-neon-blue);">← На главную</a>
        </footer>
    </div>
</body>
</html>
@code { }